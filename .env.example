# Copia este archivo como .env para desarrollo local (XAMPP).
# En producción (Vercel) estas variables se configuran en el panel del proyecto.
# NUNCA subas el archivo .env ni contraseñas reales al repositorio.

# local | production
APP_ENV=local

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_transporte
DB_USER=root
DB_PASSWORD=

# Conexión cifrada (TLS) hacia un MySQL remoto: true | false
# DB_SSL=false
# DB_SSL_CA=/ruta/al/certificado-ca.pem   (opcional; se detecta automáticamente)

# Sesiones PHP: files (XAMPP) | database (Vercel, tabla "sesiones")
# SESSION_DRIVER=files

# Producción en Vercel con MySQL de AlwaysData, ejemplo:
# APP_ENV=production
# DB_HOST=mysql-<cuenta>.alwaysdata.net
# DB_PORT=3306
# DB_NAME=<cuenta>_transporte
# DB_USER=<usuario_de_la_base>
# DB_PASSWORD=<contraseña_de_la_base>
# DB_SSL=true
# SESSION_DRIVER=database
