# Copia este archivo como .env para desarrollo local (XAMPP).
# En producción (Render) estas variables se configuran en el panel del servicio.
# NUNCA subas el archivo .env ni contraseñas reales al repositorio.

# local | production
APP_ENV=local

# mysql (XAMPP / MariaDB) | pgsql (Supabase Postgres)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_transporte
DB_USER=root
DB_PASSWORD=

# Solo para DB_DRIVER=pgsql
# DB_SCHEMA=transporte
# DB_SSLMODE=require

# files (XAMPP/Docker) | database (Vercel: sesiones en PostgreSQL)
# SESSION_DRIVER=files

# Producción con Supabase (Connect > Session pooler), ejemplo:
# APP_ENV=production
# DB_DRIVER=pgsql
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<id_del_proyecto>
# DB_PASSWORD=<contraseña_de_la_base_de_datos>
# SESSION_DRIVER=database
